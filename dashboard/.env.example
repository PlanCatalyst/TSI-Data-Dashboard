# Base URL for the published contract JSON (meta.json, countries.json, timeseries.json).
#
# Leave unset (or delete this file) to load from the local public/v1/ folder during development.
# Set to the Azure Blob public URL to fetch from the live published snapshot.
#
# Format: https://<storage-account-name>.blob.core.windows.net/dashboard-public/v1
#
# Copy this file to .env.local and fill in the value to override for your local session.
# .env.local is gitignored and will never be committed.

# VITE_CONTRACT_BASE_URL=https://<storage-account>.blob.core.windows.net/dashboard-public/v1
